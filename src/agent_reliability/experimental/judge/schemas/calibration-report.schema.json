{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gentlity.calibration-report/1",
  "title": "gentlity.calibration-report/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "created_at",
    "rubric",
    "model_label",
    "template_id",
    "configuration_id",
    "min_confidence",
    "judge_repeats",
    "repetitions",
    "dataset",
    "headline",
    "borderline",
    "adversarial",
    "repeatability",
    "failures_by_class",
    "usage",
    "misjudged_case_ids",
    "per_case"
  ],
  "$defs": {
    "rate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "numerator",
        "denominator",
        "rate",
        "wilson_low",
        "wilson_high",
        "method"
      ],
      "properties": {
        "numerator": {
          "type": "integer",
          "minimum": 0
        },
        "denominator": {
          "type": "integer",
          "minimum": 0
        },
        "rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "wilson_low": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "wilson_high": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "method": {
          "const": "wilson-95"
        }
      }
    },
    "slice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "n",
        "insufficient_for_rates",
        "matrix",
        "false_negatives",
        "false_positives",
        "over_confident",
        "abstention",
        "abstention_by_human",
        "accuracy_on_answered",
        "precision",
        "recall",
        "agreement",
        "confidence_accuracy"
      ],
      "properties": {
        "n": {
          "type": "integer",
          "minimum": 0
        },
        "insufficient_for_rates": {
          "type": "boolean"
        },
        "matrix": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pass",
            "fail",
            "unknown"
          ],
          "properties": {
            "pass": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "PASS",
                "FAIL",
                "UNKNOWN",
                "FAILURE"
              ],
              "properties": {
                "PASS": {
                  "type": "integer",
                  "minimum": 0
                },
                "FAIL": {
                  "type": "integer",
                  "minimum": 0
                },
                "UNKNOWN": {
                  "type": "integer",
                  "minimum": 0
                },
                "FAILURE": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "fail": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "PASS",
                "FAIL",
                "UNKNOWN",
                "FAILURE"
              ],
              "properties": {
                "PASS": {
                  "type": "integer",
                  "minimum": 0
                },
                "FAIL": {
                  "type": "integer",
                  "minimum": 0
                },
                "UNKNOWN": {
                  "type": "integer",
                  "minimum": 0
                },
                "FAILURE": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "unknown": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "PASS",
                "FAIL",
                "UNKNOWN",
                "FAILURE"
              ],
              "properties": {
                "PASS": {
                  "type": "integer",
                  "minimum": 0
                },
                "FAIL": {
                  "type": "integer",
                  "minimum": 0
                },
                "UNKNOWN": {
                  "type": "integer",
                  "minimum": 0
                },
                "FAILURE": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        },
        "false_negatives": {
          "type": "integer",
          "minimum": 0
        },
        "false_positives": {
          "type": "integer",
          "minimum": 0
        },
        "over_confident": {
          "type": "integer",
          "minimum": 0
        },
        "abstention": {
          "$ref": "#/$defs/rate"
        },
        "abstention_by_human": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pass",
            "fail",
            "unknown"
          ],
          "properties": {
            "pass": {
              "$ref": "#/$defs/rate"
            },
            "fail": {
              "$ref": "#/$defs/rate"
            },
            "unknown": {
              "$ref": "#/$defs/rate"
            }
          }
        },
        "accuracy_on_answered": {
          "$ref": "#/$defs/rate"
        },
        "precision": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pass",
            "fail"
          ],
          "properties": {
            "pass": {
              "$ref": "#/$defs/rate"
            },
            "fail": {
              "$ref": "#/$defs/rate"
            }
          }
        },
        "recall": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pass",
            "fail"
          ],
          "properties": {
            "pass": {
              "$ref": "#/$defs/rate"
            },
            "fail": {
              "$ref": "#/$defs/rate"
            }
          }
        },
        "agreement": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "decided",
            "raw",
            "kappa"
          ],
          "properties": {
            "decided": {
              "type": "integer",
              "minimum": 0
            },
            "raw": {
              "$ref": "#/$defs/rate"
            },
            "kappa": {
              "type": [
                "number",
                "null"
              ],
              "minimum": -1,
              "maximum": 1
            }
          }
        },
        "confidence_accuracy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "high",
            "medium",
            "low"
          ],
          "properties": {
            "high": {
              "$ref": "#/$defs/rate"
            },
            "medium": {
              "$ref": "#/$defs/rate"
            },
            "low": {
              "$ref": "#/$defs/rate"
            }
          }
        }
      }
    }
  },
  "properties": {
    "schema": {
      "const": "gentlity.calibration-report/1"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "rubric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rubric_id",
        "rubric_version",
        "fingerprint"
      ],
      "properties": {
        "rubric_id": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
        },
        "rubric_version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,126}[A-Za-z0-9])?$"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "model_label": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,62}[A-Za-z0-9])?$"
    },
    "template_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,16}$"
    },
    "configuration_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,126}[A-Za-z0-9])?$"
    },
    "min_confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "judge_repeats": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "repetitions": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_id",
        "sha256",
        "case_count",
        "by_dimension",
        "by_difficulty"
      ],
      "properties": {
        "dataset_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,128}$"
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "case_count": {
          "type": "integer",
          "minimum": 0
        },
        "by_dimension": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "answer-correctness",
              "groundedness",
              "instruction-adherence",
              "safety-policy",
              "task-completion-evidence"
            ]
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "by_difficulty": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "clear",
              "borderline",
              "adversarial",
              "ambiguous"
            ]
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "headline": {
      "$ref": "#/$defs/slice"
    },
    "borderline": {
      "$ref": "#/$defs/slice"
    },
    "adversarial": {
      "$ref": "#/$defs/slice"
    },
    "repeatability": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "repetitions",
        "cases_compared",
        "changed",
        "changed_rate",
        "changed_by_human"
      ],
      "properties": {
        "repetitions": {
          "type": "integer",
          "minimum": 2
        },
        "cases_compared": {
          "type": "integer",
          "minimum": 0
        },
        "changed": {
          "type": "integer",
          "minimum": 0
        },
        "changed_rate": {
          "$ref": "#/$defs/rate"
        },
        "changed_by_human": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pass",
            "fail",
            "unknown"
          ],
          "properties": {
            "pass": {
              "$ref": "#/$defs/rate"
            },
            "fail": {
              "$ref": "#/$defs/rate"
            },
            "unknown": {
              "$ref": "#/$defs/rate"
            }
          }
        }
      }
    },
    "failures_by_class": {
      "type": "object",
      "propertyNames": {
        "pattern": "^Judge[A-Za-z]{1,60}Error$"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "output_tokens",
        "latency_ms_total",
        "latency_ms_max"
      ],
      "properties": {
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "latency_ms_total": {
          "type": "integer",
          "minimum": 0
        },
        "latency_ms_max": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "misjudged_case_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._-]{1,128}$"
      }
    },
    "per_case": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "human_label",
          "difficulty",
          "decision"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,128}$"
          },
          "human_label": {
            "enum": [
              "pass",
              "fail",
              "unknown"
            ]
          },
          "difficulty": {
            "enum": [
              "clear",
              "borderline",
              "adversarial",
              "ambiguous"
            ]
          },
          "decision": {
            "enum": [
              "PASS",
              "FAIL",
              "UNKNOWN",
              "FAILURE"
            ]
          }
        }
      }
    }
  }
}
