{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gentlity.calibration-case/1",
  "title": "gentlity.calibration-case/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "case_id",
    "dimension",
    "parts",
    "human_label",
    "difficulty"
  ],
  "properties": {
    "schema": {
      "const": "gentlity.calibration-case/1"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,128}$"
    },
    "dimension": {
      "enum": [
        "answer-correctness",
        "groundedness",
        "instruction-adherence",
        "safety-policy",
        "task-completion-evidence"
      ]
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "text"
        ],
        "properties": {
          "role": {
            "enum": [
              "question",
              "answer",
              "reference",
              "context",
              "instructions",
              "policy",
              "task_evidence"
            ]
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "human_label": {
      "enum": [
        "pass",
        "fail",
        "unknown"
      ]
    },
    "labels": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "labeler",
          "label"
        ],
        "properties": {
          "labeler": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,64}$"
          },
          "label": {
            "enum": [
              "pass",
              "fail",
              "unknown"
            ]
          }
        }
      }
    },
    "difficulty": {
      "enum": [
        "clear",
        "borderline",
        "adversarial",
        "ambiguous"
      ]
    },
    "source": {
      "type": "string",
      "maxLength": 200
    }
  }
}
